MARIADB_HOST=
MARIADB_PORT=3306
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=pbdb_archive

PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=
# Path to CA certificate for SSL connections (e.g., AWS RDS global-bundle.pem)
PG_CA_CERT=

# Alternate path for Classic access: only needed if your copy of pbdb_archive has been
# ported into Postgres (e.g. on Aurora) instead of being reachable as a live MariaDB
# instance. Used only by scripts that import pg-classic-pool.js directly; unrelated to
# the MARIADB_* vars above.
PG_CLASSIC_HOST=
PG_CLASSIC_PORT=5432
PG_CLASSIC_USER=
PG_CLASSIC_PASSWORD=
PG_CLASSIC_DATABASE=
PG_CLASSIC_CA_CERT=

PBOT_TOKEN=
